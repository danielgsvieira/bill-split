DB_HOST_PORT=3001
DB_NAME=bill-split
DB_PASSWORD=

API_HOST_PORT=3002
API_SERVER_PORT=8000
API_NODE_ENV=production
API_DB_TYPE=postgres
API_DB_HOST=db
API_DB_PORT=5432
API_DB_NAME=bill-split
API_DB_USERNAME=
API_DB_PASSWORD=
API_ENTITIES_PATH_GLOB=**/*.entity{.js,.ts}
API_MIGRATIONS_PATH_GLOB=db/migrations/**/*{.js,.ts}
API_RUN_MIGRATIONS=true

# Public access service
FRONTEND_HOST_PORT=3003
FRONTEND_API_BASE_URL=http://<public_ip>:<same_as_API_HOST_PORT>
FRONTEND_USER_INFO_KEY=USER_INFO

# Internal network frontend service
FRONTEND_LOCAL_HOST_PORT=3004
FRONTEND_LOCAL_API_BASE_URL=http://<internal_network_ip>:<same_as_API_HOST_PORT>
